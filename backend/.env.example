PORT=3022
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:4200,https://pakabet.site,https://www.pakabet.site
MONGODB_URI=
MONGODB_DB_NAME=pakabet
# Leave MONGODB_URI blank and set LOCAL_DATA_DIR to a temporary folder when
# running isolated local payment tests with real gateway credentials.
LOCAL_DATA_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# PAYHERO KENYA API v2 SETTINGS (MPESA STK PUSH)
# Official Docs: https://docs.payhero.co.ke/
# ─────────────────────────────────────────────────────────────────────────────
PAYHERO_API_BASE=https://backend.payhero.co.ke/api/v2

# PayHero Credentials (From PayHero Dashboard -> Settings / API Keys)
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_BASIC_AUTH_TOKEN=

# Payment Channel ID (e.g. 133) - Under "Payment Channels > My Payment Channels"
PAYHERO_CHANNEL_ID=

# Optional: Registered credential ID if using custom Mpesa Daraja credentials
PAYHERO_CREDENTIAL_ID=

# Webhook Callback Endpoint (Called by PayHero upon payment completion)
PAYHERO_CALLBACK_URL=https://api.pakabet.site/api/payments/payhero/callback
PAYHERO_CALLBACK_TOKEN=

# Polling and timeout settings
PAYHERO_TEST_MODE=false
PAYHERO_PENDING_PAYMENT_EXPIRY_MS=300000

# Minimum Deposit Amount (KES)
MIN_DEPOSIT_AMOUNT=999

# Optional first-run administrator. Keep real values only in your secret store.
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=Administrator
SEED_ADMIN_EMAIL=
